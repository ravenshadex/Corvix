<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#FF111119" />
            <stroke android:width="1dp" android:color="#FF3D3D52" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#FF8A6E1C"
                    android:centerColor="#FFD4AF37"
                    android:endColor="#FFF5DF88" />
            </shape>
        </clip>
    </item>
</layer-list>
